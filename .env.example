# Dokploy > Compose servisi > Environment sekmesine kopyalayıp değerleri değiştirin.
# Rastgele değer üretmek için sunucuda: openssl rand -hex 32

# Zorunlu: tüm imzaların kökü (API anahtarı özetleri, dosya bağlantıları). Sonradan DEĞİŞTİRMEYİN;
# değişirse mevcut API anahtarları ve ses bağlantıları geçersiz olur.
SECRET_KEY=buraya-64-karakterlik-rastgele-deger

# Zorunlu: app ile engine arasındaki iç parola
ENGINE_TOKEN=buraya-baska-bir-rastgele-deger

# İlk yönetici: panele bu e-posta ve şifreyle giriş yapılır. Yalnız ilk açılışta (kullanıcı yokken)
# oluşturulur; sonra şifre ve e-posta panelden (Hesabım) değiştirilir. Önceki sürümü kurduysanız mevcut
# yöneticiye bu e-posta atanır, şifresi aynı kalır.
ADMIN_EMAIL=siz@alanadiniz.com
ADMIN_NAME=Ad Soyad
ADMIN_PASSWORD=Guclu-Bir-Sifre-123

# Domainler
PUBLIC_API_URL=https://api.alanadiniz.com
PANEL_HOSTS=panel.alanadiniz.com
API_HOSTS=api.alanadiniz.com

# Ses üretiminin kullanacağı çekirdek (KVM 8 için 6 önerilir; 2 çekirdek diğer işlere kalır)
TORCH_THREADS=6
# İkinci ses (Ahenk Cep) yüklensin mi
ENABLE_AHENK_CEP=true
ENGINE_MEMORY_LIMIT=6g
TZ=Europe/Istanbul
